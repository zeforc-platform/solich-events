{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeforc.com/solich-events/schema/v1/official-overrides.schema.json",
  "title": "Sổ Lịch official calendar overrides v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "jurisdiction",
    "year",
    "scheduleScope",
    "status",
    "updatedAt",
    "entries",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentType": { "const": "official_calendar_overrides" },
    "jurisdiction": { "$ref": "common.schema.json#/$defs/jurisdiction" },
    "year": { "type": "integer", "minimum": 1 },
    "scheduleScope": {
      "enum": ["nationwide_statutory", "public_sector_schedule"],
      "description": "Whether the annual arrangement applies uniformly or is the public-sector work schedule."
    },
    "status": { "enum": ["pending", "published"] },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/source" }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "type", "title", "holidayId", "sourceIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "date": { "type": "string", "format": "date" },
          "type": {
            "enum": [
              "official_holiday",
              "official_leave",
              "compensatory_leave",
              "compensatory_workday"
            ]
          },
          "title": { "type": "string", "minLength": 1 },
          "holidayId": { "type": "string", "minLength": 1 },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
