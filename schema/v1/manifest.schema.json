{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeforc.com/solich-events/schema/v1/manifest.schema.json",
  "title": "Sổ Lịch jurisdiction manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "jurisdiction",
    "updatedAt",
    "feeds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentType": { "const": "jurisdiction_manifest" },
    "jurisdiction": { "$ref": "common.schema.json#/$defs/jurisdiction" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "feeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["officialCatalog", "observanceCatalog", "officialOverrides"],
      "properties": {
        "officialCatalog": { "type": "string", "minLength": 1 },
        "observanceCatalog": { "type": "string", "minLength": 1 },
        "officialOverrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "path", "status"],
            "properties": {
              "year": { "type": "integer", "minimum": 1 },
              "path": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pending", "published"] }
            }
          }
        }
      }
    }
  }
}
