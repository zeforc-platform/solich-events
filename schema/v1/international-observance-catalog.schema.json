{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeforc.com/solich-events/schema/v1/international-observance-catalog.schema.json",
  "title": "Sổ Lịch international observance catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "scope",
    "kind",
    "updatedAt",
    "entries",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentType": { "const": "international_observance_catalog" },
    "scope": { "const": "international" },
    "kind": { "const": "observance" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/source" }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "icon",
          "categoryId",
          "rule",
          "effective",
          "sourceIds",
          "observanceType",
          "applicability"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "minLength": 1 },
          "categoryId": { "type": "string", "minLength": 1 },
          "rule": { "$ref": "common.schema.json#/$defs/calendarRule" },
          "effective": { "$ref": "common.schema.json#/$defs/effectivePeriod" },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "observanceType": {
            "$ref": "common.schema.json#/$defs/observanceType"
          },
          "applicability": { "$ref": "common.schema.json#/$defs/applicability" }
        }
      }
    }
  }
}
